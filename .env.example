# Required for a live IndexNow submission.
INDEXNOW_KEY=

# Optional overrides.
# INDEXNOW_SITE_URL=https://myschooldates.com
# INDEXNOW_KEY_LOCATION=https://myschooldates.com/your-indexnow-key.txt
# INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow

# Calendar correction email delivery (server-only).
NUXT_CORRECTIONS_RESEND_API_KEY=
# Use an address on a domain verified in Resend.
NUXT_CORRECTIONS_FROM="MySchoolDates <corrections@myschooldates.com>"
NUXT_CORRECTIONS_TO=hello@myschooldates.com

# Cloudflare Turnstile: managed widget for myschooldates.com and www.myschooldates.com.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFmYbpH_f2n1bxsp
NUXT_CORRECTIONS_TURNSTILE_SECRET=
NUXT_CORRECTIONS_TURNSTILE_HOSTS=myschooldates.com,www.myschooldates.com

# Enable only if the origin accepts traffic exclusively from trusted Cloudflare proxies.
NUXT_CORRECTIONS_TRUST_PROXY=false
