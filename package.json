{
  "name": "publicschoolcalendar-com",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build && node scripts/sanitize-build-paths.mjs",
    "dev": "nuxt dev",
    "generate": "nuxt generate && node scripts/sanitize-build-paths.mjs",
    "indexnow": "node scripts/submit-indexnow.mjs",
    "indexnow:prepare": "node scripts/prepare-indexnow-key.mjs",
    "trends:refresh": "node scripts/generate-school-calendar-trends.mjs",
    "trends:check": "node scripts/generate-school-calendar-trends.mjs --check",
    "verify:sources": "node scripts/verify-calendar-sources.mjs",
    "prebuild": "node scripts/prepare-indexnow-key.mjs --if-configured && node scripts/generate-calendar-route-manifest.mjs",
    "pregenerate": "node scripts/prepare-indexnow-key.mjs --if-configured && node scripts/generate-calendar-route-manifest.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/content": "3.14.0",
    "@nuxtjs/tailwindcss": "6.14.0",
    "better-sqlite3": "^12.11.1",
    "echarts": "^6.1.0",
    "nuxt": "^4.4.8",
    "vue": "^3.5.38",
    "vue-echarts": "^8.0.1",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "pdf-parse": "^2.4.5",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
